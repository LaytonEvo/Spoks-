 "flow": {
  "name": "EG · F3 Checkout abandonment",
  "definition": {
   "triggers": [
    {
     "type": "metric",
     "id": "SwrKKw",
     "trigger_filter": {
      "condition_groups": [
       {
        "conditions": [
         {
          "type": "metric-property",
          "metric_id": "SwrKKw",
          "field": "$value",
          "filter": {
           "type": "numeric",
           "operator": "greater-than-or-equal",
           "value": 30
          }
         }
        ]
       }
      ]
     }
    }
   ],
   "profile_filter": {
    "condition_groups": [
     {
      "conditions": [
