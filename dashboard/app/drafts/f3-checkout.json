   "preview": "Pick up where you left off. Free UK delivery on orders over £50.",
   "when": "Everything else · 45 minutes after checkout",
   "sender": "⛳ Evolution Golf",
   "preview_file": "f3-checkout/e1e.preview.html"
  },
  {
   "key": "e2m",
   "file": "f3-checkout/e2m.html",
   "template_name": "EG · F3 · E2 Members · Your 10% can go on this",
   "name": "E2 Members · Your 10% can go on this",
   "subject": "Your member 10% can go on this",
   "preview": "Use this month's code at checkout. Anything else we can answer?",
   "when": "Annual members, both groups · next day 09:30",
   "sender": "⛳ Evolution Golf",
   "preview_file": "f3-checkout/e2m.preview.html"
  },
  {
   "key": "e2h",
   "file": "f3-checkout/e2h.html",
