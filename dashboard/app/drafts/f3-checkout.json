   "when": "Hardware · 1 hour after checkout",
   "sender": "⛳ Evolution Golf",
   "preview_file": "f3-checkout/e1h.preview.html"
  },
  {
   "key": "e1e",
   "file": "f3-checkout/e1e.html",
