{
 "key": "f2_annual",
 "name": "F2 Membership · Annual",
 "version": 1,
 "description": "New £36 annual members: welcome (day 0), member deals (day 3), first month (day 30), two months in (day 60), the monthly 10% reminder (days 90 to 300), renewal reminder (day 335). Stops if they stop being annual.",
